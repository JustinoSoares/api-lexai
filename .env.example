# --- App ---
APP_NAME=api-lexai
DEBUG=false
LOG_LEVEL=INFO

# --- Servidor ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Base de dados (PostgreSQL + asyncpg) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lexai

# --- Redis ---
REDIS_URL=redis://localhost:6378/0

# --- RabbitMQ (fila de mensagens) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- LLM (Groq) ---
GROQ_API_KEY=coloque_a_sua_chave_aqui
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3
# Orçamento (chars) do texto de diploma injetado como grounding (default 12000)
LLM_GROUND_MAX_CHARS=12000

# --- Agente ---
WEB_SEARCH_ENABLED=true
# Domínios jurídicos priorizados na busca (JSON list). `lex.ao` fica sempre à frente.
LEGAL_WHITELIST_DOMAINS=["lex.ao","diariodarepublica.ao","governo.gov.ao","parlamento.ao","minjusdh.gov.ao","tribunalsupremo.ao","legis-palop.org","lexlink.eu","vlex.com","consultorjuridico.com","angola-forum.com"]
# Termos que reforçam a relevância de um resultado fora da whitelist (JSON list).
LEGAL_SEARCH_KEYWORDS=["lei","decreto","diploma","constituição","código civil","código penal","regulamento","boletim oficial","diário da república","assembleia nacional","ministério da justiça","legislação"]

# --- Rate limiting do /chat (proteção do free tier da Groq e das tools de busca) ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_USER_HEADER=X-User-Id

# --- Docker Compose (infra; usadas pelo docker-compose.yml, não pela API) ---
# Credenciais/portas dos serviços. Nunca as exponhas em repositórios públicos.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lexai
POSTGRES_PORT=5434
REDIS_PORT=6378
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5673
RABBITMQ_MGMT_PORT=15673

# --- Migrations no arranque da API (Docker) ---
# true = corre `alembic upgrade head` quando o container arranca
# false = NÃO corre (padrão); para migrar manualmente usa `docker compose run --rm api alembic upgrade head`
RUN_MIGRATIONS=false
