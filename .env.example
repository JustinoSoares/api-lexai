# --- App ---
APP_NAME=api-lexai
DEBUG=false
LOG_LEVEL=INFO

# --- Servidor ---
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

# --- Base de dados (PostgreSQL + asyncpg) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lexai

# --- Redis ---
REDIS_URL=redis://localhost:6378/0

# --- RabbitMQ (fila de mensagens) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- LLM (Groq) ---
GROQ_API_KEY=coloque_a_sua_chave_aqui
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.3

# --- Agente ---
WEB_SEARCH_ENABLED=true

# --- Rate limiting do /chat (proteção do free tier da Groq e das tools de busca) ---
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=10
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_USER_HEADER=X-User-Id
